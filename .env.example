# Local development. Copy to .env. These values are not production secrets.
DATABASE_URL=postgresql+asyncpg://issue:issue@localhost:5432/issue_tracker
REDIS_URL=redis://localhost:6379/0
APP_ENV=local
LOG_LEVEL=info
BOOTSTRAP_TOKEN=local-bootstrap-token
SEED_API_KEY=local-dev-api-key
API_KEY_PEPPER=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
CACHE_TTL_SECONDS=60
PORT=8000
